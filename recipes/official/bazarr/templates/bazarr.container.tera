[Unit]
Description={{ name }}

[Container]
ContainerName={{ app_id }}
Image=lscr.io/linuxserver/bazarr:1.6.2@sha256:946dc8c5bb5331418eac60050cf40a63cb8f66ac039841dda493870e3559799c
Volume={{ app_id }}-config.volume:/config
Volume={{ data_volume }}:/data
Environment={{ ("TZ=" ~ timezone) | systemd_quote }}
PublishPort={{ host_port }}:6767

[Service]
Restart=always

[Install]
WantedBy=default.target
