[Unit]
Description={{ name }}

[Container]
ContainerName={{ app_id }}
Image=lscr.io/linuxserver/prowlarr:2.6.5@sha256:b3b00047ed20f6ce2b16780145cb6a0acb51c9e28ea6aa6f5dcd33c7034f1797
Volume={{ app_id }}-config.volume:/config
Environment={{ ("TZ=" ~ timezone) | systemd_quote }}
PublishPort={{ host_port }}:9696

[Service]
Restart=always

[Install]
WantedBy=default.target
