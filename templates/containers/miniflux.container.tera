[Unit]
Description={{ name }}
Requires={{ app_id }}-db.service
After={{ app_id }}-db.service

[Container]
ContainerName={{ app_id }}
Image=docker.io/miniflux/miniflux:2.3.4@sha256:72e49f513a63104506aab98ba8cfc3a409d4fde23550a583dec07ec941f1e94e
Network={{ app_id }}-net.network
Environment={{ ("DATABASE_URL=postgres://" ~ database_user ~ ":" ~ db_password ~ "@" ~ app_id ~ "-db/" ~ database_name ~ "?sslmode=disable") | systemd_quote }}
Environment=RUN_MIGRATIONS=1
Environment=CREATE_ADMIN=1
Environment={{ ("ADMIN_USERNAME=" ~ admin_user) | systemd_quote }}
Environment={{ ("ADMIN_PASSWORD=" ~ admin_password) | systemd_quote }}
Environment={{ ("BASE_URL=" ~ public_protocol ~ "://" ~ domain ~ "/") | systemd_quote }}
PublishPort={{ host_port }}:8080

[Service]
Restart=always

[Install]
WantedBy=default.target
