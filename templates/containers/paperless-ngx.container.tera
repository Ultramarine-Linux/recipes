[Unit]
Description={{ name }}
Requires={{ app_id }}-db.service {{ app_id }}-valkey.service
After={{ app_id }}-db.service {{ app_id }}-valkey.service

[Container]
ContainerName={{ app_id }}
Image=ghcr.io/paperless-ngx/paperless-ngx:3.3.4@sha256:9bc6e8248891bcfa6f52fffe8b81e4ea8cae75790c3ec1b9906961a7ba55c969
Network={{ app_id }}-net.network
Timezone=local
Volume={{ app_id }}-data.volume:/usr/src/paperless/data
Volume={{ app_id }}-media.volume:/usr/src/paperless/media
Volume={{ app_id }}-consume.volume:/usr/src/paperless/consume
Volume={{ app_id }}-export.volume:/usr/src/paperless/export
Environment=PAPERLESS_REDIS=redis://{{ app_id }}-valkey:6379
Environment=PAPERLESS_DBENGINE=postgresql
Environment=PAPERLESS_DBHOST={{ app_id }}-db
Environment={{ ("PAPERLESS_DBNAME=" ~ database_name) | systemd_quote }}
Environment={{ ("PAPERLESS_DBUSER=" ~ database_user) | systemd_quote }}
Environment={{ ("PAPERLESS_DBPASS=" ~ db_password) | systemd_quote }}
Environment={{ ("PAPERLESS_SECRET_KEY=" ~ secret_key) | systemd_quote }}
Environment={{ ("PAPERLESS_URL=" ~ public_protocol ~ "://" ~ domain) | systemd_quote }}
Environment={{ ("PAPERLESS_ADMIN_USER=" ~ admin_user) | systemd_quote }}
Environment={{ ("PAPERLESS_ADMIN_PASSWORD=" ~ admin_password) | systemd_quote }}
Environment={{ ("PAPERLESS_OCR_LANGUAGE=" ~ ocr_language) | systemd_quote }}
PublishPort={{ host_port }}:8000

[Service]
Restart=always

[Install]
WantedBy=default.target
