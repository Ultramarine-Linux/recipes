{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/Ultramarine-Server/recipes/schema/recipe.schema.json",
	"title": "Tetra app recipe",
	"description": "Mirrors `AppRecipe` in tetra-recipe (tetra's crates/tetra-recipe). The English strings here are the translation source; `cargo run -p recipes -- extract` copies them into locales/en.json.",
	"type": "object",
	"additionalProperties": false,
	"required": ["recipe_id", "name", "version", "category", "resources"],
	"properties": {
		"recipe_id": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]*$",
			"description": "Stable id; must match the recipe's directory name."
		},
		"name": { "type": "string", "minLength": 1 },
		"description": { "type": "string" },
		"category": {
			"type": "string",
			"description": "A key of `categories` in catalog.yaml."
		},
		"icon": { "type": "string" },
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
		},
		"requires": {
			"type": "array",
			"items": {
				"oneOf": [
					{ "type": "string", "minLength": 1 },
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["key"],
						"properties": {
							"key": { "type": "string", "minLength": 1 },
							"version": { "type": "string" }
						}
					}
				]
			}
		},
		"parameters": {
			"type": "array",
			"items": { "$ref": "#/$defs/parameter" }
		},
		"resources": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/resource" }
		}
	},
	"$defs": {
		"parameter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["key", "label", "type"],
			"properties": {
				"key": {
					"type": "string",
					"pattern": "^[a-z_][a-z0-9_]*$",
					"not": {
						"enum": [
							"recipe_id",
							"name",
							"version",
							"recipe",
							"resource",
							"resource_filename",
							"resource_name"
						]
					}
				},
				"label": { "type": "string", "minLength": 1 },
				"type": { "enum": ["string", "secret", "integer", "boolean", "choice"] },
				"required": { "type": "boolean" },
				"placeholder": { "type": "string" },
				"default": { "type": ["string", "integer", "boolean"] },
				"min": { "type": "integer" },
				"max": { "type": "integer" },
				"generate": { "enum": ["random_32"] },
				"options": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				}
			}
		},
		"resource": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "filename", "template"],
			"properties": {
				"type": { "enum": ["container", "image", "network", "volume", "pod", "kube", "file"] },
				"filename": { "type": "string", "minLength": 1 },
				"template": {
					"type": "string",
					"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.tera$",
					"description": "Path under templates/."
				},
				"condition": { "type": "string" },
				"depends_on": { "type": "array", "items": { "type": "string" } }
			}
		}
	}
}
